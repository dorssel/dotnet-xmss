<Project Sdk="Microsoft.NET.Sdk.BlazorWebAssembly">

  <PropertyGroup>
    <IsPublishable>true</IsPublishable>
    <PublishProfile>Properties\PublishProfiles\FolderProfile.pubxml</PublishProfile>
    <PublishDir>bin\publish\</PublishDir>
    <OverrideHtmlAssetPlaceholders>true</OverrideHtmlAssetPlaceholders>
    <CompressionEnabled>false</CompressionEnabled>
    <!--
    Disabled, because blazor WASM multithreading is not yet supported in .NET 11 (regression, .NET 10 worked fine).
    <WasmEnableThreads Condition="'$(Configuration)' == 'Release'">true</WasmEnableThreads>
    -->
  </PropertyGroup>

  <ItemGroup>
    <Content Remove="libman.json" />
    <None Include="libman.json" />
  </ItemGroup>

  <ItemGroup>
    <SupportedPlatform Include="browser" />
    <TrimmerRootAssembly Include="Microsoft.FluentUI.AspNetCore.Components" />
    <TrimmerRootAssembly Include="WebAssembly" />
  </ItemGroup>

  <ItemGroup>
    <!--
    This is only needed for software within this repository itself.
    When referencing the NuGet package (see below) this is not required.
    -->
    <ProjectReference Include="..\..\Xmss\Xmss.csproj" />
    <!--
    <PackageReference Include="Dorssel.Security.Cryptography.Xmss" />
    -->
  </ItemGroup>

  <ItemGroup>
    <!--
    `dotnet restore` by default only restores the Debug configuration.
    On the other hand, `dotnet publish` restores the Release configuration, which already downloads this package.
    We want to pre-cache this package for a normal `dotnet restore` as well, so CI builds can use the standard restore -> build -> publish pattern.
    -->
    <PackageDownload Condition="'$(WasmEnableThreads)' != 'true'"
      Include="Microsoft.NETCore.App.Runtime.Mono.multithread.browser-wasm" Version="[$(BundledNETCoreAppPackageVersion)]" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Blazored.LocalStorage" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly" />
    <PackageReference Include="Microsoft.AspNetCore.Components.WebAssembly.DevServer" PrivateAssets="all" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components" />
    <PackageReference Include="Microsoft.FluentUI.AspNetCore.Components.Icons" />
  </ItemGroup>

</Project>
